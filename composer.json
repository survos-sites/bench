{
    "name": "survos-sites/searchbench",
    "description": "SearchBench: a Symfony application that demonstrates meili-bundle",
    "keywords": [
        "symfony",
        "meilisearch"
    ],
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": false,
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-imagick": "*",
        "ext-intl": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "ext-sqlite3": "*",
        "ext-zip": "*",
        "api-platform/core": "dev-meilisearch as 5.0.0",
        "api-platform/doctrine-orm": "^5.0@alpha",
        "api-platform/meilisearch": "^5.0@alpha",
        "api-platform/symfony": "^5.0@alpha",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.4.2",
        "easycorp/easyadmin-bundle": "^5.0",
        "friendsofsymfony/jsrouting-bundle": "dev-master",
        "halaxa/json-machine": "^1.2",
        "inspector-apm/inspector-symfony": "^1.8",
        "league/commonmark": "^2.8",
        "league/csv": "^9.24",
        "league/flysystem-aws-s3-v3": "^3.22",
        "league/flysystem-bundle": "^3.3",
        "liip/imagine-bundle": "^2.12",
        "liquid/liquid": "^1.4",
        "meilisearch/meilisearch-php": "dev-main as 2.0.0",
        "nelmio/cors-bundle": "^2.3.1",
        "openai-php/client": "^0.19.0",
        "phpdocumentor/reflection-docblock": "^5.2|^6.0",
        "phpmetrics/phpmetrics": "^3.0",
        "phpstan/phpdoc-parser": "^2.3",
        "sentry/sentry-symfony": "^4.12|^5.0",
        "sunaoka/ndjson": "^1.1",
        "survos/api-grid-bundle": "dev-main",
        "survos/atlas-bundle": "*",
        "survos/auth-bundle": "^2.0",
        "survos/command-bundle": "^2.10",
        "survos/core-bundle": "^2.0",
        "survos/crawler-bundle": "^2.0",
        "survos/elastic-bundle": "^2.24",
        "survos/ez-bundle": "^2.0",
        "survos/field-bundle": "^2.0",
        "survos/html-prettify-bundle": "^2.0",
        "survos/imgproxy-bundle": "^2.7",
        "survos/import-bundle": "^2.0",
        "survos/js-twig-bundle": "^2.0",
        "survos/jsonl-bundle": "^2.0",
        "survos/lingua-core": "^2.0",
        "survos/media-bundle": "^2.7",
        "survos/meili-bundle": "^2.0",
        "survos/schema-org-bundle": "^2.24",
        "survos/search-bundle": "^2.24",
        "survos/simple-datatables-bundle": "^2.0",
        "survos/state-bundle": "^2.0",
        "survos/tabler-bundle": "^2.0",
        "survos/tui-extras-bundle": "dev-main",
        "survos/wiki-bundle": "^2.0",
        "symfony/ai-agent": "^0.12",
        "symfony/ai-bundle": "^0.12",
        "symfony/ai-open-ai-platform": "^0.12",
        "symfony/asset": "^8.0",
        "symfony/asset-mapper": "^8.0",
        "symfony/console": "^8.0",
        "symfony/doctrine-messenger": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/flex": "^2.4.1",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/intl": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "^8.0",
        "symfony/object-mapper": "^8.0",
        "symfony/process": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/redis-messenger": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/string": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/ux-chartjs": "^3.0",
        "symfony/ux-icons": "^3.0",
        "symfony/ux-twig-component": "^3.0",
        "symfony/validator": "^8.0",
        "symfony/web-link": "^8.0",
        "symfony/yaml": "^8.0",
        "twig/extra-bundle": "^3.7.1",
        "twig/intl-extra": "^3.8",
        "twig/markdown-extra": "^3.8",
        "twig/twig": "^3.13",
        "zenstruck/messenger-monitor-bundle": "^0.6.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "endroid/installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "survos/installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "version": "^8.1"
        },
        "paas": {
            "php-config": [
                "memory_limit=1024M",
                "max_execution_time=60",
                "post_max_size=128M",
                "upload_max_filesize=128M"
            ]
        }
    },
    "require-dev": {
        "dbrekelmans/bdi": "^1.4",
        "doctrine/doctrine-fixtures-bundle": "^3.4.4||^4.0",
        "friendsofphp/php-cs-fixer": "^3.70",
        "jawira/doctrine-diagram-bundle": "^1.0",
        "nette/php-generator": "^4.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "survos/code-bundle": "dev-main",
        "survos/deployment-bundle": "^2.0",
        "survos/doc-bundle": "^2.8",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/debug-bundle": "^8.0",
        "symfony/maker-bundle": "^1.51.1",
        "symfony/panther": "dev-main",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/stopwatch": "^8.0",
        "symfony/web-profiler-bundle": "^8.0",
        "symplify/easy-coding-standard": "^13.0",
        "vincentlanglet/twig-cs-fixer": "^3.0",
        "yethee/tiktoken": "^1.0"
    },
    "repositories": [
        {
            "name": "schema-org-bundle",
            "type": "vcs",
            "url": "https://github.com/tacman/schema-org-bundle"
        },
        {
            "name": "api-platform-core",
            "type": "vcs",
            "url": "https://github.com/tacman/core-1"
        }
    ]
}
