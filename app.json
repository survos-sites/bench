{
    "name": "searchbench",
    "description": "SearchBench demos",
    "keywords": [
        "php",
        "symfony"
    ],
    "repository": "https://github.com/survos-sites/searchbench",
    "scripts": {
        "dokku": {
            "predeploy": "bench-predeploy",
            "postdeploy": "bin/console about"
        }
    },
    "env": {
        "SECRET_TOKEN": {
            "description": "A secret key for verifying the integrity of signed cookies.",
            "value": "secret"
        }
    },
    "addons": [
        "dokku-postgres",
        "dokku-redis"
    ]
}
