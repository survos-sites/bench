{% extends 'base.html.twig' %}

{% block title %}Official index{% endblock %}

{% block body %}
    {% set enhanced = useStimulus is defined ? useStimulus : true %}
    <h1>{{ enhanced ? 'Using Grid' : 'Plain HTML table' }}</h1>

    <twig:grid
        :data="officials"
        :columns="[
            {name: 'id', title: 'Id'},
            {name: 'firstName', title: 'FirstName'},
            {name: 'lastName', title: 'LastName'},
            {name: 'officialName', title: 'OfficialName'},
            {name: 'birthday', title: 'Birthday'},
            {name: 'gender', title: 'Gender'},
            {name: 'actions', title: 'actions'}
        ]"
        :pageLength="max(1, app.request.query.getInt('perPage', 10))"
        :useDatatables="enhanced"
        :trans="false"
        scrollY=""
        :options="{columnDefs: [{targets: -1, orderable: false, searchable: false}]}"
    >
        <twig:block name="birthday">{{ row.birthday ? row.birthday|date('Y-m-d') : '' }}</twig:block>
        <twig:block name="actions">
            <a href="{{ path('app_congress_show', row.rp) }}">show</a>
        </twig:block>
    </twig:grid>
{% endblock %}
