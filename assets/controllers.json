{
    "controllers": {
        "@survos/api-grid-bundle": {
            "api_grid": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/grid-bundle": {
            "grid": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/html-prettify-bundle": {
            "prettify": {
                "enabled": true,
                "fetch": "eager"
            }
        },
        "@survos/iiif-bundle": {
            "iiif-viewer": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            },
            "iiif-diva": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            },
            "iiif-pdf": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/imgproxy-bundle": {
            "imgproxy": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/js-twig-bundle": {
            "dexie": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": []
            },
            "js_twig": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            }
        },
        "@survos/meili-bundle": {
            "insta": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "instantsearch.css/themes/algolia.min.css": true,
                    "pretty-print-json/dist/css/pretty-print-json.min.css": true
                }
            },
            "json": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": []
            },
            "chat": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": {
                    "@survos/meili/styles/chat.css": true
                }
            }
        },
        "@survos/search-bundle": {
            "ux-search": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@survos/search-bundle/styles/ux-search.css": true
                }
            },
            "ux-search--refinement-list": {
                "enabled": true,
                "fetch": "eager"
            },
            "ux-search-range-slider": {
                "enabled": true,
                "fetch": "eager"
            },
            "instantsearch": {
                "enabled": false,
                "fetch": "lazy"
            }
        },
        "@survos/simple-datatables-bundle": {
            "table": {
                "enabled": true,
                "fetch": "lazy",
                "autoimport": {
                    "@survos/simple-datatables-bundle/style.css": true
                }
            }
        },
        "@survos/state-bundle": {
            "workflow": {
                "enabled": true,
                "fetch": "eager"
            }
        },
        "@survos/tabler-bundle": {
            "accordion": {
                "enabled": true,
                "fetch": "lazy"
            },
            "search": {
                "enabled": true,
                "fetch": "lazy"
            },
            "clipboard": {
                "enabled": true,
                "fetch": "lazy"
            },
            "closeable": {
                "enabled": true,
                "fetch": "lazy"
            },
            "tooltip": {
                "enabled": true,
                "fetch": "lazy"
            },
            "conditional-fields": {
                "enabled": true,
                "fetch": "lazy"
            }
        },
        "@symfony/ux-chartjs": {
            "chart": {
                "enabled": true,
                "fetch": "eager"
            }
        },
        "@symfony/ux-live-component": {
            "live": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@symfony/ux-live-component/dist/live.min.css": true
                }
            }
        }
    },
    "entrypoints": []
}
