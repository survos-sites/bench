{% extends '@SurvosTabler/layout/base.html.twig' %}
{% block title %}Product semantic search · DuckDB{% endblock %}
{% block body %}
    <div class="mb-4">
        <div class="text-secondary text-uppercase small mb-2">SearchBench · DuckDB + Nomic</div>
        <h1>Find products by what you mean</h1>
        <p class="text-secondary">Try a gift idea, a task, or something you need. Search runs against a local product snapshot.</p>
    </div>
    {% if snapshot is null %}
        <div class="alert alert-info">No product snapshot yet. Run <code>php bin/console app:duckdb:products:index</code> with Ollama running.</div>
    {% else %}
        <form method="get" class="card card-body mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-7">
                    <label class="form-label" for="product-query">What are you looking for?</label>
                    <input id="product-query" name="q" value="{{ query }}" maxlength="512" class="form-control form-control-lg" placeholder="gifts for a techie" required>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="product-category">Category</label>
                    <select id="product-category" name="category" class="form-select form-select-lg">
                        <option value="">All categories</option>
                        {% for item in snapshot.categories %}<option value="{{ item }}" {{ item == category ? 'selected' : '' }}>{{ item|replace({'-': ' '})|title }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-md-2"><button class="btn btn-primary btn-lg w-100">Search</button></div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                {% for suggestion in ['gifts for a techie', 'something for a camping trip', 'a nice scent for an evening out', 'a laptop for work'] %}
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('demo_product_duckdb', {q: suggestion}) }}">{{ suggestion }}</a>
                {% endfor %}
            </div>
        </form>
        <div class="text-secondary small mb-4">{{ snapshot.count }} products · {{ snapshot.model }} · snapshot {{ snapshot.created|date('M j, Y H:i') }} UTC</div>
    {% endif %}
    {% if error %}<div class="alert alert-warning" role="alert">{{ error }}</div>{% endif %}
    {% if result is not null %}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h3 mb-0">Closest matches</h2>
            <span class="text-secondary small">DuckDB {{ result.searchMs|number_format(1) }} ms · total {{ result.totalMs|number_format(0) }} ms</span>
        </div>
        <div class="row g-3">
            {% for hit in result.results %}
                {% set product = hit.product %}
                <div class="col-sm-6 col-lg-4">
                    <article class="card h-100">
                        <img src="{{ product.thumbnail }}" alt="{{ product.title }}" loading="lazy" class="card-img-top" style="height:180px;object-fit:contain;background:#f8fafc;padding:12px">
                        <div class="card-body">
                            <div class="text-secondary small mb-1">{{ product.category|replace({'-': ' '})|title }}</div>
                            <h3 class="card-title">{{ product.title }}</h3>
                            <div class="fw-bold mb-2">${{ product.price|number_format(2) }}</div>
                            <p class="text-secondary">{{ product.description }}</p>
                        </div>
                        <div class="card-footer small text-secondary">Cosine distance {{ hit.distance|number_format(3) }} · lower is closer</div>
                    </article>
                </div>
            {% else %}<p>No products match this category.</p>{% endfor %}
        </div>
    {% endif %}
{% endblock %}
